# Standalone DE10-Lite USB audio host wrapper; no edits to the legacy project.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY aces2_usb_audio_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_usb_audio_debug
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/aces2_usb_audio_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/de10_lite_reset_release.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/de10_lite_status_leds.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/de10_lite_usb_audio_pads.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/usb_audio_fpga_subsystem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_audio_host_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_isochronous_receiver.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_control_transfer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_enumerator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_descriptor_parser.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_host_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/max3421e_controller.sv
