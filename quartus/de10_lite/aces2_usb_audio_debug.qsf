set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/audio_sample_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/spi/spi_frame_encoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/spi/spi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/spi/spi_uc.sv
set_global_assignment -name SYSTEMVERILOG_FILE "../../third_party/spi-fpga-core/rtl/spi_master.sv"
