set_global_assignment -name SDC_FILE aces2_usb_audio.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
# Standard full-size MAX3421E shield: D9=INT, D10=CS, D11=MOSI,
# D12=MISO, D13=SCK; MAX3421E RES# follows the Arduino RESET header net.
# D8/GPX is unused and left high impedance.
