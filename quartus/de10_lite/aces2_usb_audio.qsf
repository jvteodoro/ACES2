# Standalone DE10-Lite USB audio host wrapper; no edits to the legacy project.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY aces2_usb_audio_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_usb_audio
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/aces2_usb_audio_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/de10_lite_reset_release.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/de10_lite_status_leds.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/de10_lite_usb_audio_pads.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top/usb_audio_fpga_subsystem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_audio_host_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_isochronous_receiver.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_control_transfer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_enumerator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_descriptor_parser.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_host_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/max3421e_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/max3421e_spi_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/usb_pcm_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/usb/audio_sample_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/spi/spi_frame_encoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/spi/spi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/spi/spi_uc.sv
set_global_assignment -name SYSTEMVERILOG_FILE "../../third_party/spi-fpga-core/rtl/spi_master.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../third_party/spi-fpga-core/rtl/spi_fifo.sv"
set_global_assignment -name SDC_FILE aces2_usb_audio.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
# Standard full-size MAX3421E shield: D9=INT, D10=CS, D11=MOSI,
# D12=MISO, D13=SCK; MAX3421E RES# follows the Arduino RESET header net.
# D8/GPX is unused and left high impedance.
set_location_assignment PIN_P11 -to clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50
set_location_assignment PIN_B8 -to key_n[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[0]
set_location_assignment PIN_A7 -to key_n[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[1]
